#!/usr/bin/env python3
"""Copy browser and shell state through ~/Dropbox/Vault.

Chromium history is copied only while Chromium is quit. The shell files are
copied when an interactive bash exits, and pulled again when the next one starts.
The richer copy wins when one side is almost empty, so a fresh profile does not
wipe the Vault. Otherwise the newer file wins.
"""

import base64
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
VAULT_BROWSER = os.path.join(HOME, "Dropbox/Vault/browser/chromium")
VAULT_SHELL = os.path.join(HOME, "Dropbox/Vault/shell")
PROFILE = os.path.join(HOME, ".config/chromium/Default")

OMARCHY_ROOTS = (
    os.path.join(HOME, ".local/share/omarchy"),
    "/usr/share/omarchy",
)


def say(message):
    print(f"vault-sync: {message}", flush=True)


def chromium_running():
    return subprocess.run(
        ["pgrep", "-x", "chromium"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def default_candidates(name):
    return [os.path.join(root, name) for root in OMARCHY_ROOTS]


SHELL_FILES = (
    (os.path.join(HOME, ".bashrc"), os.path.join(VAULT_SHELL, "bashrc"), "text", default_candidates("default/bashrc")),
    (os.path.join(HOME, ".bash_profile"), os.path.join(VAULT_SHELL, "bash_profile"), "text", ()),
    (os.path.join(HOME, ".profile"), os.path.join(VAULT_SHELL, "profile"), "text", ()),
    (os.path.join(HOME, ".bash_history"), os.path.join(VAULT_SHELL, "bash_history"), "lines", ()),
    (os.path.join(HOME, ".config/starship.toml"), os.path.join(VAULT_SHELL, "starship.toml"), "text", default_candidates("config/starship.toml")),
    (os.path.join(HOME, ".ssh/config"), os.path.join(HOME, "Dropbox/Vault/ssh/config"), "text", ()),
    (os.path.join(HOME, ".ssh/known_hosts"), os.path.join(HOME, "Dropbox/Vault/ssh/known_hosts"), "text", ()),
    (os.path.join(HOME, ".ssh/id_ed25519.pub"), os.path.join(HOME, "Dropbox/Vault/ssh/id_ed25519.pub"), "text", ()),
    (os.path.join(HOME, ".ssh/id_ed25519_vps.pub"), os.path.join(HOME, "Dropbox/Vault/ssh/id_ed25519_vps.pub"), "text", ()),
    (os.path.join(HOME, ".local/share/zoxide/db.zo"), os.path.join(VAULT_SHELL, "db.zo"), "bytes", ()),
)

BROWSER_FILES = (
    (os.path.join(PROFILE, "History"), os.path.join(VAULT_BROWSER, "History"), "history", ()),
    (os.path.join(PROFILE, "Shortcuts"), os.path.join(VAULT_BROWSER, "Shortcuts"), "shortcuts", ()),
)


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return None


def strip_hooks(text):
    kept = []
    skipping = False
    for line in text.splitlines():
        if "vault-sync:start" in line:
            skipping = True
            continue
        if "vault-sync:end" in line:
            skipping = False
            continue
        if not skipping:
            kept.append(line)
    body = "\n".join(kept).strip() + "\n"
    while "\n\n\n" in body:
        body = body.replace("\n\n\n", "\n\n")
    return body


def richness(path, kind):
    if not os.path.isfile(path) or os.path.getsize(path) == 0:
        return 0
    if kind == "lines":
        text = read_text(path) or ""
        return sum(1 for line in text.splitlines() if line.strip())
    if kind == "bytes" or kind == "text":
        return os.path.getsize(path)
    if kind == "history":
        return sqlite_count(path, ("urls",))
    if kind == "shortcuts":
        return sqlite_count(path, ("omni_box_shortcuts",))
    return os.path.getsize(path)


def sqlite_count(path, tables):
    try:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    except sqlite3.Error:
        return os.path.getsize(path)
    try:
        for table in tables:
            try:
                return con.execute(f"select count(*) from {table}").fetchone()[0]
            except sqlite3.Error:
                continue
        return os.path.getsize(path)
    finally:
        con.close()


def is_stock(path, defaults, kind):
    if kind != "text":
        return False
    local = read_text(path)
    if local is None:
        return False
    for candidate in defaults:
        stock = read_text(candidate)
        if stock is not None and strip_hooks(local) == strip_hooks(stock):
            return True
    return False


def same_file(a, b):
    try:
        if os.path.getsize(a) != os.path.getsize(b):
            return False
        with open(a, "rb") as left, open(b, "rb") as right:
            return left.read() == right.read()
    except OSError:
        return False


def almost_empty(local_score, vault_score):
    if vault_score <= 0 or local_score >= vault_score:
        return False
    return local_score < 50 or local_score * 20 < vault_score


def decide(local, vault, kind, defaults):
    """Return 'pull', 'push', or 'skip'."""
    local_exists = os.path.isfile(local) and os.path.getsize(local) > 0
    vault_exists = os.path.isfile(vault) and os.path.getsize(vault) > 0
    if not local_exists and not vault_exists:
        return "skip"
    if not vault_exists:
        return "push"
    if not local_exists:
        return "pull"
    if kind in ("text", "lines", "bytes") and same_file(local, vault):
        return "skip"
    local_stock = is_stock(local, defaults, kind)
    vault_stock = is_stock(vault, defaults, kind)
    if local_stock and vault_stock:
        return "skip"
    if local_stock and not vault_stock:
        return "pull"
    if vault_stock and not local_stock:
        return "push"
    local_score = richness(local, kind)
    vault_score = richness(vault, kind)
    if almost_empty(local_score, vault_score):
        return "pull"
    if almost_empty(vault_score, local_score):
        return "push"
    if os.path.getmtime(vault) > os.path.getmtime(local) + 1:
        return "pull"
    if os.path.getmtime(local) > os.path.getmtime(vault) + 1:
        return "push"
    return "skip"


def copy_file(src, dst, kind):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = dst + ".partial"
    try:
        if kind in ("history", "shortcuts"):
            src_con = sqlite3.connect(f"file:{src}?mode=ro", uri=True)
            dst_con = sqlite3.connect(tmp)
            try:
                src_con.backup(dst_con)
            finally:
                dst_con.close()
                src_con.close()
        else:
            shutil.copyfile(src, tmp)
    except (OSError, sqlite3.Error) as exc:
        if os.path.exists(tmp):
            os.remove(tmp)
        say(f"could not copy {os.path.basename(src)}: {exc}")
        return False
    private = kind in ("history", "shortcuts", "lines", "bytes")
    os.chmod(tmp, 0o600 if private else 0o644)
    os.replace(tmp, dst)
    if kind in ("history", "shortcuts"):
        for suffix in ("-wal", "-shm", "-journal"):
            extra = dst + suffix
            if os.path.exists(extra):
                os.remove(extra)
    say(f"copied {os.path.basename(src)}")
    return True


def in_chromium_profile(path):
    return path == PROFILE or path.startswith(PROFILE + os.sep)


def sync_group(files, direction):
    browser_blocked = chromium_running()
    warned = False
    for local, vault, kind, defaults in files:
        if browser_blocked and in_chromium_profile(local):
            if not warned:
                say("Chromium is open, so History and Shortcuts stay where they are")
                warned = True
            continue
        choice = decide(local, vault, kind, defaults)
        if direction == "pull" and choice != "pull":
            continue
        if direction == "push" and choice != "push":
            continue
        if direction == "reconcile" and choice == "skip":
            continue
        if choice == "pull":
            copy_file(vault, local, kind)
        elif choice == "push":
            copy_file(local, vault, kind)


def files_for(target):
    if target == "shell":
        return SHELL_FILES
    if target == "chromium":
        return BROWSER_FILES
    return SHELL_FILES + BROWSER_FILES


RC_LOCALS = {
    os.path.join(HOME, ".bashrc"),
    os.path.join(HOME, ".bash_profile"),
    os.path.join(HOME, ".profile"),
}


def shell_startup():
    """Pull shell state. Exit 0 when bashrc itself was replaced and bash should re-exec."""
    others = tuple(item for item in SHELL_FILES if item[0] not in RC_LOCALS)
    rc_files = tuple(item for item in SHELL_FILES if item[0] in RC_LOCALS)
    sync_group(others, "pull")
    replaced = False
    for local, vault, kind, defaults in rc_files:
        if decide(local, vault, kind, defaults) == "pull" and copy_file(vault, local, kind):
            replaced = True
    raise SystemExit(0 if replaced else 1)


TABLEPLUS_SCHEMA = "com.tableplus.TablePlusLinux"
VAULT_TABLEPLUS = os.path.join(HOME, "Dropbox/Vault/tableplus")
TABLEPLUS_KEYRING = os.path.join(VAULT_TABLEPLUS, "keyring.json")
TABLEPLUS_SETTINGS = (
    (
        os.path.join(HOME, ".tableplus/settings/connections.json"),
        os.path.join(VAULT_TABLEPLUS, "connections.json"),
        "text",
        (),
    ),
    (
        os.path.join(HOME, ".tableplus/settings/connection_groups.json"),
        os.path.join(VAULT_TABLEPLUS, "connection_groups.json"),
        "text",
        (),
    ),
    (
        os.path.join(HOME, ".tableplus/.tblicensenix"),
        os.path.join(VAULT_TABLEPLUS, "tblicensenix"),
        "bytes",
        (),
    ),
    (
        os.path.join(HOME, ".tableplus/.tbid"),
        os.path.join(VAULT_TABLEPLUS, "tbid"),
        "bytes",
        (),
    ),
)


def tableplus_collection():
    import secretstorage

    bus = secretstorage.dbus_init()
    collection = secretstorage.get_default_collection(bus)
    if collection.is_locked():
        collection.unlock()
    return collection


def tableplus_local_items(collection):
    found = {}
    for item in collection.get_all_items():
        attrs = item.get_attributes() or {}
        if attrs.get("xdg:schema") != TABLEPLUS_SCHEMA and attrs.get("schema") != TABLEPLUS_SCHEMA:
            continue
        key = (attrs.get("id", ""), attrs.get("type", ""))
        if not key[0] or not key[1]:
            continue
        modified = item.get_modified()
        if hasattr(modified, "isoformat"):
            modified = modified.isoformat()
        elif modified is None:
            modified = ""
        else:
            modified = str(modified)
        record = {
            "id": key[0],
            "type": key[1],
            "label": item.get_label() or f"{TABLEPLUS_SCHEMA}.{key[0]}",
            "attributes": {str(name): str(value) for name, value in attrs.items()},
            "secret_b64": base64.b64encode(item.get_secret()).decode("ascii"),
            "modified": modified,
        }
        previous = found.get(key)
        if previous is None:
            found[key] = record
            continue
        if not record["secret_b64"] and previous["secret_b64"]:
            continue
        if record["secret_b64"] and not previous["secret_b64"]:
            found[key] = record
            continue
        if record["modified"] >= previous["modified"]:
            found[key] = record
    return found


def tableplus_vault_items():
    if not os.path.isfile(TABLEPLUS_KEYRING):
        return {}
    try:
        with open(TABLEPLUS_KEYRING, encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        say(f"could not read TablePlus keyring file: {exc}")
        return {}
    found = {}
    for record in payload.get("items", []):
        key = (record.get("id", ""), record.get("type", ""))
        if key[0] and key[1]:
            found[key] = record
    return found


def write_tableplus_keyring(records):
    os.makedirs(VAULT_TABLEPLUS, exist_ok=True)
    payload = {"items": sorted(records.values(), key=lambda record: (record["id"], record["type"]))}
    tmp = TABLEPLUS_KEYRING + ".partial"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2)
        handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, TABLEPLUS_KEYRING)


def tableplus_connection_score(path):
    try:
        with open(path, encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return 0
    objects = payload.get("objects") if isinstance(payload, dict) else None
    if not isinstance(objects, list):
        return 0
    return sum(1 for item in objects if isinstance(item, dict) and item.get("db-driver"))


def sync_tableplus_settings(direction):
    local, vault = TABLEPLUS_SETTINGS[0][0], TABLEPLUS_SETTINGS[0][1]
    local_score = tableplus_connection_score(local)
    vault_score = tableplus_connection_score(vault)
    if vault_score > local_score and direction != "push":
        copy_file(vault, local, "text")
    elif local_score > vault_score and direction != "pull":
        copy_file(local, vault, "text")
    sync_group(TABLEPLUS_SETTINGS, direction)


CURSOR_SKILLS = (
    (
        os.path.join(HOME, ".cursor/skills/dr/SKILL.md"),
        os.path.join(HOME, "Dropbox/Vault/cursor/skills/dr/SKILL.md"),
        "text",
        (),
    ),
    (
        os.path.join(HOME, ".cursor/skills/save/SKILL.md"),
        os.path.join(HOME, "Dropbox/Vault/cursor/skills/save/SKILL.md"),
        "text",
        (),
    ),
)


def sync_machine_state(direction="reconcile"):
    sync_tableplus(direction)
    sync_group(CURSOR_SKILLS, direction)


def sync_tableplus(direction="reconcile"):
    sync_tableplus_settings(direction)
    try:
        collection = tableplus_collection()
        local = tableplus_local_items(collection)
    except Exception as exc:
        say(f"TablePlus keyring was not synced: {exc}")
        return
    vault = tableplus_vault_items()
    changed = False
    imported = 0
    for key in sorted(set(local) | set(vault)):
        here = local.get(key)
        there = vault.get(key)
        if here and there and here["secret_b64"] == there["secret_b64"]:
            continue
        if here and there and here["secret_b64"] and not there["secret_b64"]:
            local_newer = True
        elif here and there and there["secret_b64"] and not here["secret_b64"]:
            local_newer = False
        else:
            local_newer = here is not None and (there is None or here["modified"] >= there.get("modified", ""))
        if direction == "pull":
            local_newer = False
        if direction == "push":
            local_newer = here is not None
        if local_newer:
            vault[key] = here
            changed = True
            continue
        if there is None or direction == "push" or not there.get("secret_b64"):
            continue
        secret = base64.b64decode(there["secret_b64"])
        attributes = {str(name): str(value) for name, value in there.get("attributes", {}).items()}
        try:
            collection.create_item(there["label"], attributes, secret, replace=True)
        except Exception as exc:
            say(f"could not restore a TablePlus password: {exc}")
            continue
        imported += 1
        vault[key] = there
    if changed and direction != "pull":
        write_tableplus_keyring(vault)
        say(f"copied TablePlus keyring ({len(vault)} items)")
    elif imported:
        say(f"restored {imported} TablePlus keyring items")


def watch_chromium():
    say("watching Chromium")
    next_tableplus = 0.0
    while True:
        now = time.time()
        if now >= next_tableplus:
            sync_machine_state("reconcile")
            next_tableplus = now + 30
        if chromium_running():
            while chromium_running():
                now = time.time()
                if now >= next_tableplus:
                    sync_machine_state("reconcile")
                    next_tableplus = now + 30
                time.sleep(2)
            time.sleep(1)
            if chromium_running():
                continue
            sync_group(BROWSER_FILES, "push")
        else:
            sync_group(BROWSER_FILES, "pull")
            for _ in range(5):
                if chromium_running():
                    break
                time.sleep(1)


def main(argv):
    command = argv[1] if len(argv) > 1 else "reconcile"
    target = argv[2] if len(argv) > 2 else "all"
    if command == "watch-chromium":
        watch_chromium()
        return
    if command == "shell-startup":
        shell_startup()
        return
    if command not in ("pull", "push", "reconcile", "plan"):
        say("use pull, push, reconcile, plan, shell-startup, or watch-chromium")
        raise SystemExit(2)
    selected = files_for(target)
    if command == "plan":
        for local, vault, kind, defaults in selected:
            say(f"{decide(local, vault, kind, defaults)} {local}")
        return
    sync_group(selected, command)
    if target == "all":
        sync_machine_state(command)


if __name__ == "__main__":
    main(sys.argv)
